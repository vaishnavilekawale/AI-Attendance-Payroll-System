# ============================================================================
# AI Attendance & Payroll System — environment template
#
# HOW TO USE:
#   1. Copy this file and rename the copy to `.env`
#   2. Place that `.env` NEXT TO the .exe (packaged build) or next to
#      app.py (local development) — see config.py's BASE_DIR resolution.
#   3. Fill in the real values below for THIS install.
#
# This file (.env.example) contains NO real secrets and is safe to commit
# to version control / include in the source zip you hand off. The actual
# `.env` file (with real values) must NEVER be committed or shared — each
# install/customer should get its own, and it should be treated exactly
# like a password: back it up, don't email it, don't zip it into a
# deliverable you send around.
# ============================================================================

# ── Flask Core ───────────────────────────────────────────────────────────
# Leave SECRET_KEY blank/unset for a NEW install — config.py will
# automatically generate a secure random one and write it back into this
# file on first run. Only set it manually if you're restoring a backup of
# an existing install's .env (in which case, use that install's original
# value — do not generate a new one, or all existing sessions/CSRF tokens
# become invalid).
SECRET_KEY=

# production | development — always use `production` for anything handed
# to a customer. `development` enables Flask's interactive debugger, which
# allows remote code execution if the app is ever reachable by anyone else.
FLASK_ENV=production

# ── Database ─────────────────────────────────────────────────────────────
# Leave unset/commented to default to a local SQLite file at
# instance/attendance.db (next to the .exe) — the right choice for a
# single-site desktop install. Only set this for a MySQL deployment.
# DATABASE_URL=mysql+pymysql://username:password@localhost/attendance_db

# ── Email (SMTP) — payslip delivery, password resets, notifications ──────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-company@gmail.com
# Use an SMTP "app password", NOT your normal account password — Gmail,
# Outlook, etc. all require this for third-party app access.
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=your-company@gmail.com

# ── Company Branding ──────────────────────────────────────────────────────
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_LOGO=static/images/company_logo.png

# ── Office Timing ─────────────────────────────────────────────────────────
OFFICE_START_TIME=09:00
OFFICE_END_TIME=18:00
GRACE_PERIOD_MINUTES=15

# ── Working Hours & Salary Rules ──────────────────────────────────────────
WORKING_HOURS_PER_DAY=9.0
LATE_DEDUCTION_ENABLED=false
LATE_DEDUCTION_PER_OCCURRENCE=0.0
OVERTIME_ENABLED=true
OVERTIME_RATE=1.5

# ── Face Recognition ──────────────────────────────────────────────────────
FACE_RECOGNITION_TOLERANCE=0.6
MIN_FACE_IMAGES_REQUIRED=20



# ── Biometric Encryption Key ──────────────────────────────────────────────
# Leave blank/unset for a NEW install — crypto_utils.py will automatically
# generate one and write it back into this file the first time it's
# needed. Only set this manually when restoring a backup of an existing
# install (use that install's ORIGINAL value). If this key is ever lost
# or changed, every previously-encrypted face photo becomes permanently
# unreadable — this is inherent to encryption, back up .env accordingly.
# FACE_DATA_ENCRYPTION_KEY=


