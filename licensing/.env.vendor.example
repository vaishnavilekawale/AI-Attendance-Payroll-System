# ============================================================================
# VENDOR PORTAL settings  (copy to  licensing/.env.vendor  on YOUR server)
#
# NEVER put this file, vendor_private_key.pem or customers.db inside a build
# you hand to a customer. Loaded automatically by licensing/vendor_app.py
# (override the location with VENDOR_ENV_FILE).
# ============================================================================

# ── Razorpay (https://dashboard.razorpay.com) ────────────────────────────
# Settings -> API Keys.  Use rzp_test_* while testing, rzp_live_* in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings -> Webhooks -> Add New Webhook
#   URL:    https://<your-domain>/webhook/razorpay
#   Events: payment.captured  and  order.paid
#   Secret: any long random string - put the SAME string here.
# (This is NOT the API secret above.)
RAZORPAY_WEBHOOK_SECRET=

# ── Prices in RUPEES (normal units): 999 = Rs 999, 499.50 = Rs 499.50 ───
PLAN_CURRENCY=INR
PLAN_PRICE_MONTHLY=999
PLAN_PRICE_YEARLY=9999
PLAN_PRICE_LIFETIME=24999

# ── Licence signing key (see licensing/keygen.py) ─────────────────────────
# Either leave both unset and keep vendor_private_key.pem next to keygen.py
# (or in VENDOR_DATA_DIR), or point to / embed it here:
# VENDOR_PRIVATE_KEY_PATH=/secure/path/vendor_private_key.pem
# VENDOR_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMC4CAQ...\n-----END PRIVATE KEY-----

# ── Where customers.db / logs live (use a persistent disk when hosted) ───
# VENDOR_DATA_DIR=/var/data/aiaps-vendor

# ── Email that delivers the licence ───────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-company@gmail.com
# Gmail/Outlook need an "app password", not your normal password.
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=your-company@gmail.com
SENDER_NAME=AI Attendance & Payroll System
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_WEBSITE=https://example.com
SUPPORT_EMAIL=support@yourcompany.com

# ── Admin API (/vendor/*) - REQUIRED, otherwise the API is switched off ──
VENDOR_ADMIN_USER=admin
VENDOR_ADMIN_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────
# Set when running behind nginx / Cloudflare so rate limits see real client IPs.
# VENDOR_TRUST_PROXY=true
# VENDOR_SECRET_KEY=<random string>
# HOST=0.0.0.0
# PORT=8000

# ── LOCAL TESTING ONLY: fake payments, no Razorpay account needed ───────
# VENDOR_DEV_MODE=true
